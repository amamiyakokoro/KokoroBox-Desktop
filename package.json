{
  "name": "kokorobox-desktop",
  "desktopName": "kokorobox.desktop",
  "version": "4.26.10-2",
  "description": "KokoroBox",
  "main": "./out/main/index.js",
  "author": {
    "name": "KokoroBox contributors",
    "email": "10204811+PhoenixEmik@users.noreply.github.com"
  },
  "homepage": "https://github.com/amamiyakokoro/KokoroBox-Desktop",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test:localization": "tsx --test scripts/test-localization.ts",
    "test:backup": "tsx --test scripts/test-backup.ts",
    "test:override-user-agent": "tsx --test scripts/test-override-user-agent.ts",
    "test:pinned-https-agent": "tsx --test scripts/test-pinned-https-agent.ts",
    "test:main-process-errors": "tsx --test scripts/test-main-process-errors.ts",
    "test:gist-filenames": "tsx --test scripts/test-gist-filenames.ts",
    "test:core-hook-path": "tsx --test scripts/test-core-hook-path.ts",
    "test:user-data-migration": "tsx --test scripts/test-user-data-migration.ts",
    "test:app-config": "tsx --test scripts/test-app-config-recovery.ts",
    "test:app-routing": "tsx --test scripts/test-app-routing.ts scripts/test-process-router-events.ts",
    "test:dns": "tsx --test scripts/test-dns.ts scripts/test-dns-lease-controller.ts",
    "test:runtime-recovery": "tsx --test scripts/test-settings-failures.ts scripts/test-runtime-recovery.ts scripts/test-override-execution.ts scripts/test-traffic-history.ts scripts/test-core-firewall.ts",
    "test:settings": "tsx --test scripts/test-settings.ts scripts/test-tour-navigation.ts",
    "test:logs": "tsx --test scripts/test-log-actions.ts scripts/test-service-logs.ts scripts/test-diagnostic-logs.ts",
    "test:yaml": "tsx --test scripts/test-yaml.ts",
    "test:home": "tsx --tsconfig tsconfig.web.json --test scripts/test-home-data.ts scripts/test-home-background.ts scripts/test-home-ui.tsx scripts/test-home-overview.tsx scripts/test-home-app-metadata.ts",
    "test:ui-native": "tsx --test scripts/test-ui-native-contract.ts",
    "test:service-auth": "tsx --test scripts/test-service-auth.ts",
    "test:service-contract": "tsx --test scripts/test-service-contract.ts",
    "test:system-proxy": "tsx --test scripts/test-system-proxy.ts scripts/test-system-proxy-diagnostics.ts scripts/test-linux-system-proxy-diagnostics.ts scripts/test-macos-system-proxy-diagnostics.ts scripts/test-dns-diagnostics.ts scripts/test-service-pac.ts",
    "test:uwp-loopback": "tsx --test scripts/test-uwp-loopback.ts",
    "test:native-migrations": "tsx --test scripts/test-native-migrations.ts scripts/test-native-process.ts",
    "test:traffic-presenter": "tsx --test scripts/test-traffic-presenter.ts",
    "test:release": "tsx --test scripts/test-release.ts",
    "test:mihomo-alpha": "tsx --test scripts/test-mihomo-alpha-release.ts",
    "test:macos-signing": "tsx --test scripts/test-macos-signing.ts",
    "test:macos-sparkle": "tsx --test scripts/test-macos-sparkle.ts",
    "test:kokoro": "tsx --test scripts/test-kokoro-auth.ts",
    "ensure:electron": "node scripts/install-electron.ts",
    "prepare": "node scripts/prepare.ts",
    "prepare:macos-routing": "node scripts/prepare-macos-routing.ts",
    "prepare:macos-updater": "node scripts/macos-sparkle.ts",
    "checksum": "node scripts/checksum.ts",
    "dev": "pnpm run ensure:electron && electron-vite dev",
    "postinstall": "pnpm run ensure:electron && electron-builder install-app-deps",
    "build:win": "electron-vite build && electron-builder --publish never --win nsis",
    "build:mac": "pnpm run prepare:macos-routing && pnpm run prepare:macos-updater && electron-vite build && electron-builder --publish never --mac",
    "build:linux": "electron-vite build && node scripts/package-linux.ts",
    "test:licenses": "tsx --test scripts/test-third-party-licenses.ts scripts/test-component-licenses.ts",
    "test:speed-test": "tsx --test scripts/test-speed-test.ts",
    "test:about": "tsx --tsconfig tsconfig.web.json --test scripts/test-about.ts scripts/test-about-license.tsx"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "adm-zip": "^0.6.1",
    "age-encryption": "^0.3.1",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "iconv-lite": "^0.7.3",
    "kokorobox-native": "0.16.5",
    "remark-gfm": "4.0.1",
    "tldts": "^7.4.16",
    "webdav": "^5.11.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electron-toolkit/eslint-config-prettier": "^3.0.1",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@heroui/react": "3.2.6",
    "@heroui/styles": "3.2.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.4",
    "@types/pubsub-js": "^1.8.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "driver.js": "^1.8.0",
    "electron": "^44.5.1",
    "electron-builder": "26.17.0",
    "electron-vite": "^6.0.0-beta.5",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "form-data": "^4.0.6",
    "is-cidr": "^7.0.3",
    "is-ip": "^5.0.1",
    "js-md5": "^0.9.2",
    "js-yaml": "^5.4.2",
    "lodash": "^4.18.1",
    "meta-json-schema": "^1.19.31",
    "monaco-editor": "^0.57.0",
    "monaco-yaml": "^5.5.1",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "prettier": "^3.9.9",
    "pubsub-js": "^1.9.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-aria": "^3.52.1",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.16",
    "swr": "^2.5.1",
    "tailwindcss": "^4.3.3",
    "tar": "^7.5.22",
    "tsx": "^4.23.15",
    "types-pac": "^1.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  },
  "packageManager": "pnpm@11.1.1"
}
