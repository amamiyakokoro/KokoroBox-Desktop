#!/bin/sh

APP_PATH="/Applications/KokoroBox.app"
SERVICE_STATE_FILE="/tmp/kokorobox-service-was-running"
SMAPP_SERVICE_FILE="/tmp/kokorobox-service-was-smappservice"
LEGACY_INSTALLED_FILE="/tmp/kokorobox-service-was-installed"

/bin/chmod 0755 "$APP_PATH/Contents/Resources/sidecar/mihomo"
/bin/chmod 0755 "$APP_PATH/Contents/Resources/sidecar/mihomo-alpha"

# SMAppService keeps the daemon in the replaceable application bundle. If it
# was running before this recovery PKG replaced the app, start the registered
# job again from the new bundle. Legacy installations are registered by the
# app on first use so macOS can obtain explicit user approval.
if [ -f "$SMAPP_SERVICE_FILE" ] && [ -f "$SERVICE_STATE_FILE" ]; then
  /bin/launchctl kickstart -k system/KokoroBoxService >/dev/null 2>&1 || true
fi

/bin/rm -f "$SERVICE_STATE_FILE" "$SMAPP_SERVICE_FILE" "$LEGACY_INSTALLED_FILE" 2>/dev/null || true

exit 0
