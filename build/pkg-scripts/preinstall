#!/bin/sh

OLD_SYSPROXY="/Library/PrivilegedHelperTools/sparkle.helper"
KOKOROBOX_SERVICE_NAME="KokoroBoxService"
LEGACY_SERVICE_NAME="SparkleService"
SERVICE_STATE_FILE="/tmp/kokorobox-service-was-running"
SMAPP_SERVICE_FILE="/tmp/kokorobox-service-was-smappservice"
LEGACY_INSTALLED_FILE="/tmp/kokorobox-service-was-installed"
APP_PATH="/Applications/KokoroBox.app"
SERVICE_DIR="$APP_PATH/Contents/Resources/files"
KOKOROBOX_SERVICE_BUNDLED_BIN="$SERVICE_DIR/kokorobox-service"
KOKOROBOX_SERVICE_RUNTIME_BIN="/Library/PrivilegedHelperTools/com.amamiyakokoro.kokorobox-service"
KOKOROBOX_SERVICE_PLIST="/Library/LaunchDaemons/KokoroBoxService.plist"
KOKOROBOX_SERVICE_BIN="$KOKOROBOX_SERVICE_RUNTIME_BIN"
LEGACY_SERVICE_BIN="$SERVICE_DIR/sparkle-service"

rm -f "$SERVICE_STATE_FILE" "$SMAPP_SERVICE_FILE" "$LEGACY_INSTALLED_FILE" 2>/dev/null || true

if [ ! -x "$KOKOROBOX_SERVICE_BIN" ]; then
    KOKOROBOX_SERVICE_BIN="$KOKOROBOX_SERVICE_BUNDLED_BIN"
fi

UNINSTALL=false

service_binary_reports_running() {
    service_bin="$1"
    [ -x "$service_bin" ] || return 1
    STATUS_OUTPUT="$("$service_bin" service status 2>&1 || true)"
    printf '%s' "$STATUS_OUTPUT" | grep -Eq '服务状态：运行中|running'
}

launch_service_reports_running() {
    service_name="$1"
    launchctl list 2>/dev/null | awk -v name="$service_name" '$3 == name && $1 != "-" { found = 1 } END { exit found ? 0 : 1 }'
}

service_is_running() {
    service_name="$1"
    service_bin="$2"
    service_binary_reports_running "$service_bin" || launch_service_reports_running "$service_name"
}

stop_service() {
    service_name="$1"
    service_bin="$2"
    if launchctl kill SIGTERM "system/$service_name" >/dev/null 2>&1; then
        return
    fi
    if [ -x "$service_bin" ]; then
        "$service_bin" service stop >/dev/null 2>&1 || true
    else
        launchctl stop "$service_name" >/dev/null 2>&1 || true
    fi
}

wait_service_stopped() {
    service_name="$1"
    service_bin="$2"
    i=0
    while [ "$i" -lt 30 ]; do
        if ! service_is_running "$service_name" "$service_bin"; then
            return 0
        fi
        sleep 0.5
        i=$((i + 1))
    done
    return 1
}

stop_service_if_running() {
    service_name="$1"
    service_bin="$2"
    record_state="$3"
    if ! service_is_running "$service_name" "$service_bin"; then
        return
    fi

    if [ "$record_state" = true ] && ! touch "$SERVICE_STATE_FILE"; then
        echo "Failed to record running KokoroBox service state" >&2
        exit 1
    fi

    stop_service "$service_name" "$service_bin"
    if wait_service_stopped "$service_name" "$service_bin"; then
        return
    fi

    echo "KokoroBox service is still running; aborting install to avoid replacing active files" >&2
    exit 1
}

if [ ! -f "$KOKOROBOX_SERVICE_PLIST" ] && launchctl print system/KokoroBoxService >/dev/null 2>&1; then
    if ! touch "$SMAPP_SERVICE_FILE"; then
        echo "Failed to record SMAppService registration state" >&2
        exit 1
    fi
fi

stop_service_if_running "$KOKOROBOX_SERVICE_NAME" "$KOKOROBOX_SERVICE_BIN" true
stop_service_if_running "$LEGACY_SERVICE_NAME" "$LEGACY_SERVICE_BIN" false

# A legacy installation copied the daemon and plist outside the application.
# SMAppService installations keep both inside the signed application bundle.
if [ -f "$KOKOROBOX_SERVICE_PLIST" ]; then
    launchctl bootout system/KokoroBoxService >/dev/null 2>&1 || true
    rm -f "$KOKOROBOX_SERVICE_PLIST"
fi
rm -f "$KOKOROBOX_SERVICE_RUNTIME_BIN"

if [ ! -f "$OLD_SYSPROXY" ]; then
    UNINSTALL=true
fi

if [ "$UNINSTALL" = true ]; then
    if launchctl list | grep -q "sparkle.helper"; then
        launchctl stop sparkle.helper 2>/dev/null || true
        launchctl unload /Library/LaunchDaemons/sparkle.helper.plist 2>/dev/null || true
    fi

    for file in "/Library/LaunchDaemons/sparkle.helper.plist" \
               "/Library/PrivilegedHelperTools/sparkle.helper" \
               "/tmp/sparkle.helper" \
               "/tmp/sparkle-helper.sock"; do
        if [ -e "$file" ]; then
            rm -f "$file"
        fi
    done
fi

exit 0
