#!/bin/bash

KOKOROBOX_SERVICE_NAME='KokoroBoxService'
LEGACY_SERVICE_NAME='SparkleService'
STATE_DIR='/run/kokorobox'
STATE_FILE="$STATE_DIR/service-was-running"

ensure_state_dir() {
    mkdir -p "$STATE_DIR"
}

mark_service_running() {
    ensure_state_dir && touch "$STATE_FILE"
}

service_pid() {
    service_name="$1"
    for pid_file in "/var/run/$service_name.pid" "/run/$service_name.pid"; do
        if [ -f "$pid_file" ]; then
            pid="$(cat "$pid_file" 2>/dev/null || true)"
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                printf '%s\n' "$pid"
                return 0
            fi
        fi
    done
    return 1
}

service_is_running() {
    service_name="$1"
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet "$service_name"; then
        return 0
    fi

    service_pid "$service_name" >/dev/null 2>&1
}

stop_service() {
    service_name="$1"
    if command -v systemctl >/dev/null 2>&1; then
        systemctl stop "$service_name" >/dev/null 2>&1 || true
    fi
    if command -v service >/dev/null 2>&1; then
        service "$service_name" stop >/dev/null 2>&1 || true
    fi
    if [ -x "/etc/init.d/$service_name" ]; then
        "/etc/init.d/$service_name" stop >/dev/null 2>&1 || true
    fi
}

force_stop_pid() {
    pid="$(service_pid "$1" 2>/dev/null || true)"
    if [ -n "$pid" ]; then
        kill "$pid" >/dev/null 2>&1 || true
    fi
}

wait_service_stopped() {
    service_name="$1"
    i=0
    while [ "$i" -lt 30 ]; do
        if ! service_is_running "$service_name"; then
            return 0
        fi
        sleep 0.5
        i=$((i + 1))
    done
    return 1
}

stop_service_if_running() {
    service_name="$1"
    if ! service_is_running "$service_name"; then
        return
    fi

    if ! mark_service_running; then
        echo "Failed to record running KokoroBox service state" >&2
        exit 1
    fi

    stop_service "$service_name"
    if wait_service_stopped "$service_name"; then
        return
    fi

    force_stop_pid "$service_name"
    if wait_service_stopped "$service_name"; then
        return
    fi

    echo "KokoroBox service is still running; aborting install to avoid replacing active files" >&2
    exit 1
}

stop_service_if_running "$KOKOROBOX_SERVICE_NAME"
stop_service_if_running "$LEGACY_SERVICE_NAME"

exit 0
