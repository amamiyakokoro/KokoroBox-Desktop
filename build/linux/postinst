#!/bin/bash

install_launcher() {
    launcher="$1"
    target="$2"
    alternative="$3"

    if [ ! -f "$launcher" ] || [ -L "$launcher" ]; then
        if type update-alternatives >/dev/null 2>&1; then
            if [ -L "$launcher" ] && [ -e "$launcher" ] && [ "$(readlink "$launcher")" != "/etc/alternatives/$alternative" ]; then
                rm -f "$launcher"
            fi
            update-alternatives --install "$launcher" "$alternative" "$target" 100 || ln -sf "$target" "$launcher"
        else
            ln -sf "$target" "$launcher"
        fi
    fi
}

install_launcher '/usr/bin/kokorobox' '/opt/kokorobox/kokorobox' 'kokorobox'

# Keep command-line upgrades working when the old launcher belongs to this
# package. New installations should use /usr/bin/kokorobox.
if [ ! -f '/usr/bin/sparkle' ] || [ -L '/usr/bin/sparkle' ]; then
    if type update-alternatives 2>/dev/null >&1; then
        if [ -L '/usr/bin/sparkle' -a -e '/usr/bin/sparkle' -a "`readlink '/usr/bin/sparkle'`" != '/etc/alternatives/sparkle' ]; then
            rm -f '/usr/bin/sparkle'
        fi
        update-alternatives --install '/usr/bin/sparkle' 'sparkle' '/opt/kokorobox/kokorobox' 10 || ln -sf '/opt/kokorobox/kokorobox' '/usr/bin/sparkle'
    else
        ln -sf '/opt/kokorobox/kokorobox' '/usr/bin/sparkle'
    fi
fi

chmod 4755 '/opt/kokorobox/chrome-sandbox' || true
chmod +sx /opt/kokorobox/resources/sidecar/mihomo
chmod +sx /opt/kokorobox/resources/sidecar/mihomo-alpha

restore_sparkle_service_if_was_running() {
    SERVICE_NAME='SparkleService'
    STATE_FILE='/run/sparkle/service-was-running'

    if [ ! -f "$STATE_FILE" ]; then
        return
    fi
    rm -f "$STATE_FILE" 2>/dev/null || true

    if command -v systemctl >/dev/null 2>&1; then
        systemctl start "$SERVICE_NAME" >/dev/null 2>&1 || true
    elif command -v service >/dev/null 2>&1; then
        service "$SERVICE_NAME" start >/dev/null 2>&1 || true
    elif [ -x "/etc/init.d/$SERVICE_NAME" ]; then
        "/etc/init.d/$SERVICE_NAME" start >/dev/null 2>&1 || true
    fi
}

restore_sparkle_service_if_was_running

if hash update-mime-database 2>/dev/null; then
    update-mime-database /usr/share/mime || true
fi

if hash update-desktop-database 2>/dev/null; then
    update-desktop-database /usr/share/applications || true
fi
