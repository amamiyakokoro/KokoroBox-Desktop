pkgname=kokorobox-electron-git
_pkgname=${pkgname%-electron-git}
pkgver=1.26.7.r17.g2fed67e
pkgrel=1
pkgdesc="KokoroBox desktop Mihomo client"
arch=('x86_64' 'aarch64')
url="https://github.com/amamiyakokoro/KokoroBox-Desktop"
license=('GPL-3.0-only')
provides=("$_pkgname=$pkgver")
replaces=('sparkle-electron-git')
conflicts=("$_pkgname" "$_pkgname-git" "$_pkgname-bin" "$_pkgname-rolling-bin" "$_pkgname-electron" "$_pkgname-electron-bin"
           'sparkle' 'sparkle-bin' 'sparkle-git' 'sparkle-rolling-bin' 'sparkle-electron' 'sparkle-electron-bin' 'sparkle-electron-git')
depends=('electron' 'alsa-lib' 'gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'util-linux-libs' 'libsecret')
optdepends=('libappindicator-gtk3: Allow KokoroBox to extend a menu via Ayatana indicators in Unity, KDE or Systray (GTK+ 3 library).')
makedepends=('git' 'nodejs' 'pnpm' 'libxcrypt-compat' 'asar')
install=$_pkgname.install
source=(
    "${_pkgname}.desktop"
    "${_pkgname}.sh"
    "${_pkgname}::git+$url.git"
)
sha256sums=(
    "2e3c4314e0ed25dd80ef70ce8644dea06119a127fb33ac4e3b42fd2286ff5ee4"
    "25fa0f187393c8d9e614b044dfc6e2a46a65b422ca7ece784f82cbc3c8947c8f"
    "SKIP"
)
options=('!debug' '!lto')

pkgver() {
    cd $srcdir/${_pkgname}
    ( set -o pipefail
        git describe --long --tags --exclude=rolling --exclude=pre-release 2>/dev/null | sed 's/\([^-]*-g\)/r\1/;s/-/./g' | tr -d 'v' ||
        printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    )
}

prepare(){
    cd $srcdir/${_pkgname}
    pnpm install
}

build(){
    cd $srcdir/${_pkgname}
    pnpm build:linux deb
}

package() {
    asar extract $srcdir/${_pkgname}/dist/linux-unpacked/resources/app.asar ${pkgdir}/opt/kokorobox
    cp -r $srcdir/${_pkgname}/extra/sidecar ${pkgdir}/opt/kokorobox/resources/
    cp -r $srcdir/${_pkgname}/extra/files ${pkgdir}/opt/kokorobox/resources/
    chmod +x ${pkgdir}/opt/kokorobox/resources/files/sparkle-service
    chmod +sx ${pkgdir}/opt/kokorobox/resources/sidecar/mihomo
    chmod +sx ${pkgdir}/opt/kokorobox/resources/sidecar/mihomo-alpha
    install -Dm755 "${_pkgname}.sh" "${pkgdir}/usr/bin/${_pkgname}"
    install -Dm644 "${_pkgname}.desktop" "${pkgdir}/usr/share/applications/${_pkgname}.desktop"
    install -Dm644 "${pkgdir}/opt/kokorobox/resources/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/${_pkgname}.png"

    chown -R root:root ${pkgdir}
}
