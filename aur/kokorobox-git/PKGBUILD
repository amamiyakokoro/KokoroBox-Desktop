pkgname=kokorobox-git
_pkgname=${pkgname%-git}
pkgver=1.26.7.r17.g2fed67e
pkgrel=1
pkgdesc="KokoroBox desktop Mihomo client"
arch=('x86_64' 'aarch64')
url="https://github.com/amamiyakokoro/KokoroBox-Desktop"
license=('GPL-3.0-only')
provides=("$_pkgname=$pkgver")
replaces=('sparkle-git')
conflicts=("$_pkgname" "$_pkgname-bin" "$_pkgname-rolling-bin" "$_pkgname-electron" "$_pkgname-electron-bin" "$_pkgname-electron-git"
           'sparkle' 'sparkle-bin' 'sparkle-git' 'sparkle-rolling-bin' 'sparkle-electron' 'sparkle-electron-bin' 'sparkle-electron-git')
depends=('alsa-lib' 'gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core' 'util-linux-libs' 'libsecret')
optdepends=('libappindicator-gtk3: Allow KokoroBox to extend a menu via Ayatana indicators in Unity, KDE or Systray (GTK+ 3 library).')
makedepends=('git' 'nodejs' 'pnpm' 'jq' 'libxcrypt-compat' 'libarchive')
install=$_pkgname.install
source=("${_pkgname}.sh" "${_pkgname}::git+$url.git")
sha256sums=("24f4e0d8f452566f0cba9af5e6c2297eb443f84613eb4ff1a774c0ae03afbba0" "SKIP")
options=('!debug' '!lto')

pkgver() {
    cd $srcdir/${_pkgname}
    ( set -o pipefail
        git describe --long --tags --exclude=rolling --exclude=pre-release 2>/dev/null | sed 's/\([^-]*-g\)/r\1/;s/-/./g' | tr -d 'v' ||
        printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
    )
}

prepare(){
    cd $srcdir/${_pkgname}
    pnpm install
}

build(){
    cd $srcdir/${_pkgname}
    pnpm build:linux deb
}

package() {
	cd $srcdir/${_pkgname}/dist
    bsdtar -xf kokorobox-desktop-linux-$(jq '.version' $srcdir/${_pkgname}/package.json | tr -d 'v"')*.deb
    bsdtar -xf data.tar.xz -C "${pkgdir}/"
    chmod +x ${pkgdir}/opt/kokorobox/kokorobox
    chmod +x ${pkgdir}/opt/kokorobox/resources/files/kokorobox-service
    chmod +sx ${pkgdir}/opt/kokorobox/resources/sidecar/mihomo
    chmod +sx ${pkgdir}/opt/kokorobox/resources/sidecar/mihomo-alpha
    install -Dm755 "${srcdir}/../${_pkgname}.sh" "${pkgdir}/usr/bin/${_pkgname}"
    sed -i '3s!/opt/kokorobox/kokorobox!kokorobox!' "${pkgdir}/usr/share/applications/${_pkgname}.desktop"

    chown -R root:root ${pkgdir}
}
